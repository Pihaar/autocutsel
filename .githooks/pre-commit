#!/bin/sh
# Pre-commit hook: static checks for autocutsel
# Install: git config core.hooksPath .githooks
set -e

# C syntax check (fast, no linking)
# libinput headers live in a subdirectory on some distributions; ask pkg-config.
_incflags=$(pkg-config --cflags libinput 2>/dev/null || true)
for f in src/*.c; do
  # shellcheck disable=SC2086
  gcc -fsyntax-only -include config.h -I. $_incflags "$f" 2>/dev/null || {
    echo "FAIL: syntax error in $f"
    exit 1
  }
done

# Shell script syntax check
for f in tests/*.sh bootstrap; do
  if [ -f "$f" ]; then
    sh -n "$f" || { echo "FAIL: syntax error in $f"; exit 1; }
  fi
done

# Shellcheck (if available)
if command -v shellcheck >/dev/null 2>&1; then
  shellcheck -s sh -x -P tests -e SC2039,SC3045 tests/*.sh || {
    echo "FAIL: shellcheck found issues"
    exit 1
  }
fi
